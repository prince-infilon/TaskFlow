# ==============================================================================
# TaskFlow Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Port for the Node/Express backend server (default: 5000)
PORT=5000

# Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Logging level: 'error', 'warn', 'info', 'http', 'debug'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Allowed client frontend origin for CORS and OAuth redirects
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. DATABASE (MONGODB)
# ------------------------------------------------------------------------------
# MongoDB connection string (local or MongoDB Atlas SRV connection string)
MONGODB_URI=mongodb://localhost:27017/taskflow

# Optional test database connection URI used when running automated test suites
MONGODB_TEST_URI=mongodb://localhost:27017/taskflow_test

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# Secure random string (minimum 32-64 characters) for signing short-lived Access Tokens
JWT_SECRET=replace_with_a_super_secure_random_jwt_secret_key_32_chars_min

# Secure random string for signing long-lived Refresh Tokens
JWT_REFRESH_SECRET=replace_with_a_super_secure_refresh_token_secret_key

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED CACHE & RATE LIMITING (REDIS)
# ------------------------------------------------------------------------------
# Optional Redis connection string for distributed rate limiting & session cache.
# If omitted, rate limiting falls back to local in-memory storage.
# REDIS_URI=redis://localhost:6379

# ------------------------------------------------------------------------------
# 6. STRIPE BILLING & SUBSCRIPTIONS
# ------------------------------------------------------------------------------
# Secret API key from Stripe Dashboard (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Webhook signing secret from Stripe CLI / Dashboard (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# Stripe Price IDs for Subscription Tiers
STRIPE_PRO_PRICE_ID=price_replace_with_pro_monthly_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_replace_with_enterprise_price_id

# ------------------------------------------------------------------------------
# 7. OAUTH SSO PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Azure AD App Credentials
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 8. MONITORING & OBSERVABILITY (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
